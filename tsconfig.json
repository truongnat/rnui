{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-native",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@rnui/component-schema": [
        "./packages/component-schema/src",
        "./packages/component-schema/src/*"
      ],
      "@rnui/renderer": [
        "./packages/renderer/src",
        "./packages/renderer/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "packages/component-schema"
    },
    {
      "path": "packages/renderer"
    }
  ]
}
