{
  "name": "@truongdq01/themes",
  "version": "1.0.3",
  "private": false,
  "description": "Multi-brand color presets for RNUI ThemeProvider",
  "repository": {
    "type": "git",
    "url": "https://github.com/truongnat/rnui.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "react-native",
    "ui",
    "theme",
    "brand",
    "dark-mode"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./neutral": {
      "types": "./dist/brands/neutral.d.ts",
      "import": "./dist/brands/neutral.mjs",
      "require": "./dist/brands/neutral.js"
    },
    "./stone": {
      "types": "./dist/brands/stone.d.ts",
      "import": "./dist/brands/stone.mjs",
      "require": "./dist/brands/stone.js"
    },
    "./butter": {
      "types": "./dist/brands/butter.d.ts",
      "import": "./dist/brands/butter.mjs",
      "require": "./dist/brands/butter.js"
    },
    "./chocolate": {
      "types": "./dist/brands/chocolate.d.ts",
      "import": "./dist/brands/chocolate.mjs",
      "require": "./dist/brands/chocolate.js"
    },
    "./matcha": {
      "types": "./dist/brands/matcha.d.ts",
      "import": "./dist/brands/matcha.mjs",
      "require": "./dist/brands/matcha.js"
    },
    "./gothic": {
      "types": "./dist/brands/gothic.d.ts",
      "import": "./dist/brands/gothic.mjs",
      "require": "./dist/brands/gothic.js"
    },
    "./y2k": {
      "types": "./dist/brands/y2k.d.ts",
      "import": "./dist/brands/y2k.mjs",
      "require": "./dist/brands/y2k.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup && bun tsc -p tsconfig.types.json && cp -r dist-types/. dist/ && rm -rf dist-types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "test": "bun test",
    "test:jest": "bash ../headless/scripts/run-jest.sh --passWithNoTests",
    "clean": "rm -rf dist dist-types"
  },
  "dependencies": {
    "@truongdq01/tokens": "^1.0.3"
  },
  "peerDependencies": {
    "@truongdq01/headless": "^1.0.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
