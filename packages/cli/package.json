{
  "name": "@rnui/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for RNUI registry — init NativeWind/Uniwind setup and add shadcn-style components to React Native apps",
  "type": "module",
  "bin": {
    "rnui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
