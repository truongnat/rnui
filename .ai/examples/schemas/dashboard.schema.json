{
  "id": "dashboard",
  "name": "Dashboard",
  "version": "1",
  "description": "App home with greeting, stats, filters, and activity",
  "actions": [
    {
      "id": "createTask",
      "description": "Create a new task"
    }
  ],
  "root": {
    "type": "Screen",
    "props": {
      "padding": "md",
      "spacing": "lg"
    },
    "children": [
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "md",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Stack",
                "props": {
                  "spacing": "xs"
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "variant": "h4",
                      "children": "Good morning, Truong"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "variant": "muted",
                      "children": "Sunday · 3 tasks due today"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "Badge",
            "props": {
              "variant": "secondary",
              "children": "Pro"
            }
          }
        ]
      },
      {
        "type": "Alert",
        "props": {
          "children": "You have 3 tasks due today. Review your priorities."
        }
      },
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "md"
        },
        "children": [
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "variant": "muted",
                          "children": "Open tasks"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "variant": "large",
                          "children": "12"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "variant": "muted",
                          "children": "Completed"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "variant": "large",
                          "children": "48"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "sm",
          "wrap": true
        },
        "children": [
          {
            "type": "Chip",
            "props": {
              "label": "All",
              "selected": true
            }
          },
          {
            "type": "Chip",
            "props": {
              "label": "Design",
              "variant": "outlined"
            }
          },
          {
            "type": "Chip",
            "props": {
              "label": "Engineering",
              "variant": "outlined"
            }
          }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": {
              "spacing": "sm"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "variant": "large",
                  "children": "Recent activity"
                }
              },
              {
                "type": "Text",
                "props": {
                  "variant": "muted",
                  "children": "Shipped login screen polish · 2h ago"
                }
              },
              {
                "type": "Text",
                "props": {
                  "variant": "muted",
                  "children": "Updated dashboard schema · 5h ago"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Button",
        "props": {
          "children": "Create task",
          "action": "createTask"
        }
      }
    ]
  }
}
