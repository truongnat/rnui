{
  "id": "profile-card",
  "name": "Profile Card",
  "version": "1",
  "description": "Profile hero with stats and actions",
  "actions": [
    {
      "id": "editProfile",
      "description": "Edit profile details"
    },
    {
      "id": "shareProfile",
      "description": "Share profile link"
    }
  ],
  "root": {
    "type": "Screen",
    "props": {
      "padding": "md",
      "spacing": "lg"
    },
    "children": [
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": {
              "spacing": "md",
              "alignItems": "center"
            },
            "children": [
              {
                "type": "Avatar",
                "children": [
                  {
                    "type": "AvatarFallback",
                    "props": {
                      "children": "TD"
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": {
                  "spacing": "xs",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "variant": "large",
                      "children": "Truong Dev"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "variant": "muted",
                      "children": "Product designer · San Francisco"
                    }
                  },
                  {
                    "type": "Badge",
                    "props": {
                      "variant": "secondary",
                      "children": "Pro member"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "md"
        },
        "children": [
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs",
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "variant": "large",
                          "children": "128"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "variant": "muted",
                          "children": "Projects"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs",
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "variant": "large",
                          "children": "2.4k"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "variant": "muted",
                          "children": "Followers"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs",
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "variant": "large",
                          "children": "98%"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "variant": "muted",
                          "children": "Rating"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "md"
        },
        "children": [
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Button",
                "props": {
                  "children": "Edit profile",
                  "action": "editProfile"
                }
              }
            ]
          },
          {
            "type": "View",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Button",
                "props": {
                  "children": "Share",
                  "variant": "outline",
                  "action": "shareProfile"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
