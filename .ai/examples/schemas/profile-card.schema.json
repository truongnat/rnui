{
  "id": "profile-card",
  "name": "Profile Card",
  "version": "1",
  "description": "Profile hero with stats and actions",
  "actions": [
    {
      "id": "editProfile",
      "description": "Edit profile details"
    },
    {
      "id": "shareProfile",
      "description": "Share profile link"
    }
  ],
  "root": {
    "type": "Screen",
    "props": {
      "padding": "md",
      "spacing": "lg"
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "padding": "lg"
        },
        "children": [
          {
            "type": "Stack",
            "props": {
              "spacing": "md",
              "alignItems": "center"
            },
            "children": [
              {
                "type": "Avatar",
                "props": {
                  "initials": "TD",
                  "size": "xl",
                  "status": "online"
                }
              },
              {
                "type": "Stack",
                "props": {
                  "spacing": "xs",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "Typography",
                    "props": {
                      "variant": "h5",
                      "children": "Truong Dev"
                    }
                  },
                  {
                    "type": "Typography",
                    "props": {
                      "variant": "body2",
                      "color": "secondary",
                      "children": "Product designer · San Francisco"
                    }
                  },
                  {
                    "type": "Badge",
                    "props": {
                      "label": "Pro member",
                      "variant": "brand",
                      "size": "sm"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "md"
        },
        "children": [
          {
            "type": "Box",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "props": {
                  "padding": "sm"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs",
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "Typography",
                        "props": {
                          "variant": "h6",
                          "children": "128"
                        }
                      },
                      {
                        "type": "Typography",
                        "props": {
                          "variant": "caption",
                          "color": "secondary",
                          "children": "Projects"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "props": {
                  "padding": "sm"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs",
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "Typography",
                        "props": {
                          "variant": "h6",
                          "children": "2.4k"
                        }
                      },
                      {
                        "type": "Typography",
                        "props": {
                          "variant": "caption",
                          "color": "secondary",
                          "children": "Followers"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "flex": 1
            },
            "children": [
              {
                "type": "Card",
                "props": {
                  "padding": "sm"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs",
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "Typography",
                        "props": {
                          "variant": "h6",
                          "children": "98%"
                        }
                      },
                      {
                        "type": "Typography",
                        "props": {
                          "variant": "caption",
                          "color": "secondary",
                          "children": "Rating"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Stack",
        "props": {
          "direction": "row",
          "spacing": "md"
        },
        "children": [
          {
            "type": "Button",
            "props": {
              "label": "Edit profile",
              "variant": "solid",
              "fullWidth": true,
              "action": "editProfile"
            }
          },
          {
            "type": "Button",
            "props": {
              "label": "Share",
              "variant": "outline",
              "fullWidth": true,
              "action": "shareProfile"
            }
          }
        ]
      }
    ]
  }
}
