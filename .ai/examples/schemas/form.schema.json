{
  "id": "form",
  "name": "Contact Form",
  "version": "1",
  "description": "Card-wrapped contact form with labeled fields",
  "actions": [
    {
      "id": "submit",
      "description": "Submit the contact form"
    }
  ],
  "root": {
    "type": "Screen",
    "props": {
      "padding": "md",
      "spacing": "lg"
    },
    "children": [
      {
        "type": "Stack",
        "props": {
          "spacing": "xs"
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "variant": "h4",
              "children": "Contact us"
            }
          },
          {
            "type": "Text",
            "props": {
              "variant": "muted",
              "children": "We typically respond within one business day."
            }
          }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": {
              "spacing": "md"
            },
            "children": [
              {
                "type": "TextField",
                "props": {
                  "label": "Full name",
                  "placeholder": "Jane Doe",
                  "value": ""
                }
              },
              {
                "type": "TextField",
                "props": {
                  "label": "Email",
                  "placeholder": "jane@company.com",
                  "keyboardType": "email-address",
                  "value": ""
                }
              },
              {
                "type": "TextField",
                "props": {
                  "label": "Message",
                  "placeholder": "How can we help?",
                  "multiline": true,
                  "value": ""
                }
              },
              {
                "type": "Alert",
                "props": {
                  "children": "Demo: include a phone number for urgent requests."
                }
              },
              {
                "type": "Button",
                "props": {
                  "children": "Send message",
                  "action": "submit"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
