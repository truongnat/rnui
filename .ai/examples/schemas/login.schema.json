{
  "id": "login",
  "name": "Login",
  "version": "1",
  "description": "Centered auth screen with avatar, card form, and secondary action",
  "actions": [
    {
      "id": "signIn",
      "description": "Submit credentials"
    },
    {
      "id": "forgotPassword",
      "description": "Open password recovery"
    }
  ],
  "root": {
    "type": "Screen",
    "props": {
      "padding": "lg",
      "spacing": "xs"
    },
    "children": [
      {
        "type": "View",
        "props": {
          "flex": 1
        },
        "children": [
          {
            "type": "Stack",
            "props": {
              "spacing": "lg",
              "justifyContent": "center",
              "alignItems": "stretch"
            },
            "children": [
              {
                "type": "Stack",
                "props": {
                  "spacing": "sm",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "Avatar",
                    "props": {
                      "accessibilityLabel": "RNUI"
                    },
                    "children": [
                      {
                        "type": "AvatarFallback",
                        "props": {
                          "children": "RN"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "props": {
                      "variant": "h3",
                      "children": "Welcome back"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "variant": "muted",
                      "children": "Sign in to your account to continue"
                    }
                  }
                ]
              },
              {
                "type": "Card",
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "md"
                    },
                    "children": [
                      {
                        "type": "TextField",
                        "props": {
                          "label": "Email",
                          "placeholder": "you@example.com",
                          "keyboardType": "email-address",
                          "value": ""
                        }
                      },
                      {
                        "type": "TextField",
                        "props": {
                          "label": "Password",
                          "placeholder": "Enter your password",
                          "secureTextEntry": true,
                          "value": ""
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "children": "Sign in",
                          "action": "signIn"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Stack",
                "props": {
                  "spacing": "xs",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "Button",
                    "props": {
                      "children": "Forgot password?",
                      "variant": "ghost",
                      "action": "forgotPassword"
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "variant": "muted",
                      "children": "By signing in you agree to the Terms of Service."
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
