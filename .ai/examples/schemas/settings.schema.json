{
  "id": "settings",
  "name": "Settings",
  "version": "1",
  "description": "Profile header and preference toggles",
  "actions": [
    {
      "id": "signOut",
      "description": "Sign out of the account"
    }
  ],
  "root": {
    "type": "Screen",
    "props": {
      "padding": "md",
      "spacing": "lg"
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "variant": "h4",
          "children": "Settings"
        }
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": {
              "direction": "row",
              "spacing": "md",
              "alignItems": "center"
            },
            "children": [
              {
                "type": "Avatar",
                "children": [
                  {
                    "type": "AvatarFallback",
                    "props": {
                      "children": "TD"
                    }
                  }
                ]
              },
              {
                "type": "View",
                "props": {
                  "flex": 1
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "spacing": "xs"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "variant": "large",
                          "children": "Truong Dev"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "variant": "muted",
                          "children": "truong@example.com"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": {
              "spacing": "md"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "variant": "small",
                  "children": "Preferences"
                }
              },
              {
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "spacing": "sm",
                  "alignItems": "center",
                  "justifyContent": "space-between"
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "children": "Push notifications"
                    }
                  },
                  {
                    "type": "Switch",
                    "props": {
                      "checked": true
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "spacing": "sm",
                  "alignItems": "center",
                  "justifyContent": "space-between"
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "children": "Email updates"
                    }
                  },
                  {
                    "type": "Switch",
                    "props": {
                      "checked": false
                    }
                  }
                ]
              },
              {
                "type": "Separator",
                "props": {}
              },
              {
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "spacing": "sm",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": true
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "children": "Share anonymous analytics"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Button",
        "props": {
          "children": "Sign out",
          "variant": "destructive",
          "action": "signOut"
        }
      }
    ]
  }
}
