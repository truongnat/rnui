{
  "libraryName": "RNUI",
  "description": "AI-native React Native UI kit — shadcn-style registry: components are copied into the consumer's project (npx shadcn add) under components/ui/, styled with NativeWind/Uniwind classes.",
  "distributionModel": {
    "type": "registry",
    "cli": "npx shadcn add <registry-url>/<variant>/<item>.json",
    "variants": ["nativewind", "uniwind"],
    "catalog": "registry/registry.json",
    "consumerPath": "components/ui/<name>.tsx",
    "importStyle": "import { Button } from '@/components/ui/button';",
    "utils": "import { cn, useThemeColor } from '@/lib/utils';"
  },
  "internalPackages": {
    "@rnui/component-schema": "Machine-readable component contracts + ScreenSchema validation",
    "@rnui/renderer": "ScreenSchema renderer + TSX export",
    "@rnui/cli": "init/add/list for registry (publish pending)"
  },
  "supportedRuntime": {
    "react": "19.x",
    "reactNative": ">=0.83",
    "expo": "supported through example app",
    "newArchitecture": "recommended",
    "stylingEngine": ["nativewind v4 (tailwind v3)", "uniwind (tailwind v4, CSS-first)"]
  },
  "designPrinciples": [
    "Prefer existing RNUI registry components over custom UI",
    "Style with Tailwind classes via cn(); semantic color tokens only — never raw hex or magic spacing",
    "Dynamic state colors go through the style prop (useThemeColor) — never toggle var-referencing classes at runtime (Hermes OOM)",
    "Mobile-first, accessible, production-like screens",
    "TypeScript-safe generated code for Expo / React Native",
    "Honor reduced motion for non-essential animations"
  ],
  "designSystemBaseline": {
    "name": "Astryx Design System",
    "docs": "https://astryx.atmeta.com/docs/getting-started",
    "note": "RNUI aligns color, shape, spacing, typography, and motion with Astryx (adapted for React Native)."
  },
  "themeBrands": {
    "note": "Registry 'theme' item + theme-<brand> items ship CSS var presets per variant (global.css / @theme).",
    "available": ["neutral", "stone", "butter", "chocolate", "matcha", "gothic", "y2k"]
  },
  "componentRegistryPath": ".ai/component-registry.json",
  "componentSchemaPath": ".ai/generated/component-schema.json",
  "webPreviewComponentsPath": ".ai/generated/web-preview-components.json",
  "componentSchemaGuidePath": ".ai/component-schema-guide.md",
  "screenSchemaGuidePath": ".ai/screen-schema-guide.md",
  "rendererPackage": "@rnui/renderer",
  "designRulesPath": ".ai/design-rules.md",
  "screenGenerationGuidePath": ".ai/screen-generation.md",
  "agentInstructionsPath": "AGENTS.md",
  "promptTemplates": {
    "buildScreen": ".ai/prompts/build-screen.md",
    "buildAppFlow": ".ai/prompts/build-app-flow.md",
    "addComponentDoc": ".ai/prompts/add-component-doc.md",
    "reviewRnuiUsage": ".ai/prompts/review-rnui-usage.md",
    "refactorToRnui": ".ai/prompts/refactor-to-rnui.md"
  },
  "examples": {
    "login": ".ai/examples/login-screen.tsx",
    "settings": ".ai/examples/settings-screen.tsx",
    "profile": ".ai/examples/profile-screen.tsx",
    "dashboard": ".ai/examples/dashboard-screen.tsx",
    "listDetail": ".ai/examples/list-detail-screen.tsx",
    "form": ".ai/examples/form-screen.tsx"
  },
  "schemaExamples": {
    "login": ".ai/examples/schemas/login.schema.json",
    "settings": ".ai/examples/schemas/settings.schema.json",
    "profileCard": ".ai/examples/schemas/profile-card.schema.json",
    "dashboard": ".ai/examples/schemas/dashboard.schema.json",
    "form": ".ai/examples/schemas/form.schema.json"
  },
  "forbiddenPatterns": [
    "Custom Button, Card, Input, or Text when the registry provides them",
    "Hardcoded hex colors instead of semantic Tailwind tokens",
    "Random spacing/radius/shadow numbers outside the scale",
    "New UI libraries without explicit approval",
    "Toggling var-referencing classes dynamically (use style + useThemeColor)",
    "Falsy && render with empty string or zero in JSX"
  ],
  "recommendedImports": [
    "import { Button } from '@/components/ui/button';",
    "import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';",
    "import { Text } from '@/components/ui/text';",
    "import { cn } from '@/lib/utils';"
  ],
  "optionalNativePeers": {
    "@shopify/flash-list": "animated-list/select list performance",
    "expo-blur": "glass-card native blur",
    "expo-linear-gradient": "gradient backgrounds",
    "react-native-svg": "icon, circular-progress",
    "lucide-react-native": "icon",
    "react-native-safe-area-context": "sheet, modal, tab-bar"
  }
}
