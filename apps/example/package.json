    "@rnui/component-schema": "workspace:*",
    "@rnui/renderer": "workspace:*",
    "@shopify/flash-list": "^2.0.2",
    "@shopify/react-native-skia": "^2.14.0",
    "babel-preset-expo": "^55.0.11",
    "clsx": "^2.1.1",
    "expo": "~55.0.0",
    "expo-blur": "^55.0.12",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.27",
    "expo-haptics": "~55.0.8",
    "expo-router": "~55.0.0",
    "expo-system-ui": "^55.0.9",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
