{
  "name": "@rnui/example",
  "version": "0.0.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "rm -rf ios/build",
    "ios:fresh": "expo prebuild --clean -p ios && expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:showcases": "tsc --noEmit"
  },
  "dependencies": {
